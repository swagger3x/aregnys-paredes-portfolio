---
import { education } from '../data/resume';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
---

<section id="education" class="section pt-0!" aria-labelledby="education-title">
  <div class="container-page">
    <SectionHeading eyebrow="education" title="Education" id="education-title" />

    <ul class="grid gap-5 md:grid-cols-2">
      {
        education.map((item) => (
          <li class="card flex gap-5 p-6 sm:p-8" data-reveal>
            <span class="grid size-12 shrink-0 place-items-center rounded-xl border border-line bg-surface-2 text-accent">
              <Icon name="graduation-cap" size={24} />
            </span>
            <div>
              <h3 class="text-lg font-semibold tracking-tight">{item.degree}</h3>
              <p class="mt-1 font-medium text-accent">{item.school}</p>
              <p class="mt-2 font-mono text-xs text-muted sm:text-sm">
                {item.start} – {item.end} · {item.location}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
