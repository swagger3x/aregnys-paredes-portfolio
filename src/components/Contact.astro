---
import { phoneHref, profile } from '../data/resume';
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface ContactItem {
  icon: IconName;
  label: string;
  value: string;
  href: string;
  external?: boolean;
}

const items: ContactItem[] = [
  { icon: 'mail', label: 'Email', value: profile.email, href: `mailto:${profile.email}` },
  { icon: 'phone', label: 'Phone', value: profile.phone, href: phoneHref },
  ...(profile.linkedin
    ? [
        {
          icon: 'linkedin' as const,
          label: 'LinkedIn',
          value: profile.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, ''),
          href: profile.linkedin,
          external: true,
        },
      ]
    : []),
];
---

<section id="contact" class="section pt-0!" aria-labelledby="contact-title">
  <div class="container-page">
    <div class="card relative overflow-hidden p-8 sm:p-12" data-reveal>
      <div class="glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-center">
        <div>
          <p class="eyebrow">// contact</p>
          <h2 id="contact-title" class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl">
            Let's talk about your models.
          </h2>
          <p class="mt-4 max-w-lg text-base leading-relaxed text-muted sm:text-lg">
            Always glad to talk about LLM applications, model evaluation, multi-agent systems, or secure AI.
          </p>
          <a href={profile.resumePdf} class="btn btn-primary mt-8" target="_blank" rel="noopener">
            <Icon name="download" size={18} />
            Download Résumé (PDF)
          </a>
        </div>

        <ul class="space-y-3">
          {
            items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group flex items-center gap-4 rounded-xl border border-line bg-surface-2/60 p-4 transition-colors hover:border-accent"
                  {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  <span class="grid size-11 shrink-0 place-items-center rounded-lg bg-bg text-accent">
                    <Icon name={item.icon} />
                  </span>
                  <span class="min-w-0">
                    <span class="block font-mono text-xs tracking-wider text-subtle uppercase">{item.label}</span>
                    <span class="block truncate font-medium text-fg group-hover:text-accent">{item.value}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
