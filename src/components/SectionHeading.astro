---
interface Props {
  eyebrow: string;
  title: string;
  id?: string;
}

const { eyebrow, title, id } = Astro.props;
---

<div class="mb-12 max-w-2xl sm:mb-14" data-reveal>
  <p class="eyebrow">// {eyebrow}</p>
  <h2 id={id} class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl">{title}</h2>
  {
    Astro.slots.has('default') && (
      <p class="mt-4 text-base leading-relaxed text-muted sm:text-lg">
        <slot />
      </p>
    )
  }
</div>
